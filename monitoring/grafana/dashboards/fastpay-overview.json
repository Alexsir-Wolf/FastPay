{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Requests - Rate",
      "targets": [
        { "expr": "rate(http_requests_received_total[1m])", "legendFormat": "{{method}} {{code}}" }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "HTTP Duration (p95)",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95" }
      ],
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "In-Progress Requests",
      "targets": [
        { "expr": "http_requests_in_progress" }
      ],
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
    }
  ],
  "schemaVersion": 38,
  "version": 1,
  "title": "FastPay - Overview",
  "time": {"from": "now-15m", "to": "now"}
}

